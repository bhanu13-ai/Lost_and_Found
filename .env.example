# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas SRV connection string (configure via AI Studio Secrets or .env).
# Example: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=""

# MONGODB_DB: Target database name inside your MongoDB Atlas cluster.
MONGODB_DB="sai_campus_lost_found"

# JWT_SECRET: Secret key used to sign authentication JWT tokens.
JWT_SECRET="sai-university-lost-and-found-jwt-secret"

# CLOUDINARY_URL: Optional Cloudinary connection string for external image storage.
CLOUDINARY_URL=""
